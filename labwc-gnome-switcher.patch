+{
+	struct view *start = server.cycle.selected_view;
+	struct wl_list *link = &start->cycle_link;
+	do {
+		link = backwards ? link->prev : link->next;
+		if (link == &server.cycle.views) {
+			link = backwards ? link->prev : link->next;
+		}
+		struct view *view = wl_container_of(link, view, cycle_link);
+		if (cycle_same_app(start, view)) {
+			server.cycle.selected_view = view;
+			break;
+		}
+	} while (link != &start->cycle_link);
+	server.cycle.window_selection = true;
+	server.cycle.show_windows = true;
+	update_cycle();
