+// SPDX-License-Identifier: GPL-2.0-only
+/* GNOME-style application switcher, using the compositor's native cycle list. */
+#include <assert.h>
+#include <glib.h>
+#include <stdlib.h>
+#include <string.h>
+#include <wlr/types/wlr_scene.h>
+#include <wlr/types/wlr_output_layout.h>
+#include "buffer.h"
+#include "common/box.h"
+#include "common/buf.h"
+#include "common/graphic-helpers.h"
+#include "common/list.h"
+#include "common/mem.h"
+#include "common/scene-helpers.h"
+#include "config/rcxml.h"
+#include "cycle.h"
+#include "labwc.h"
+#include "node.h"
+#include "output.h"
+#include "scaled-buffer/scaled-buffer.h"
+#include "scaled-buffer/scaled-font-buffer.h"
+#include "scaled-buffer/scaled-icon-buffer.h"
+#include "view.h"
+
+/*
+ * GNOME Shell _switcher-popup.scss / altTab.js metrics and palette:
+ *   $base_padding = 6px, $switcher_padding = 12px, $switcher_radius = 28px
+ *   .switcher-popup { spacing: 24px; }
+ *   .switcher-list { background: #2e2e33; border: 1px solid rgba(255,255,255,0.02);
+ *                    padding: 12px; border-radius: 28px; }
+ *   .switcher-list-item-container { spacing: 12px; }
+ *   .item-box { padding: 6px; spacing: 6px; border-radius: 16px; }
+ *   .item-box:selected { background: rgba(255,255,255,0.2); }
+ *   .item-box:highlighted { background: #414149; } // st-lighten(#2e2e33, 8%)
+ *   .thumbnail-box { padding: 2px; spacing: 6px; }
+ *   .thumbnail { width: 256px; }
+ */
+#define SWITCHER_PADDING 12
+#define SWITCHER_RADIUS 28
+#define POPUP_SPACING 24
+#define ITEM_SPACING 12
+#define ITEM_PADDING 6
+#define ITEM_RADIUS 16
+#define THUMB_BOX_PADDING 2
+#define THUMB_DEFAULT_SIZE 256
+#define ARROW_WIDTH 8
+#define ARROW_HEIGHT 4
+static const float background[] = {0x2e / 255.0f, 0x2e / 255.0f, 0x33 / 255.0f, 1};
+static const float panel_border[] = {0.02f, 0.02f, 0.02f, 0.02f};
+static const float selected[] = {0.2f, 0.2f, 0.2f, 0.2f};
+static const float highlighted[] = {0x41 / 255.0f, 0x41 / 255.0f, 0x49 / 255.0f, 1};
+static const float foreground[] = {1, 1, 1, 1};
+static const float arrow_dim[] = {0.8f, 0.8f, 0.8f, 0.8f};
+static const float transparent[] = {0, 0, 0, 0};
+
+struct shape {
+	float color[4];
+	float border[4];
+	int width, height, radius;
+	bool arrow;
+};
+
+struct application_item {
+	struct cycle_osd_item base;
+	struct scaled_buffer *selected, *highlighted;
+	struct scaled_buffer *arrow_dim, *arrow_bright;
+	/* Non-NULL on application tiles; NULL on individual window tiles. */
+	struct wlr_scene_tree *windows;
+	int index, slots, step, app_count;
+};
+
+static void
+rounded_rect(cairo_t *cr, double x, double y, double w, double h, double r)
+{
+	cairo_new_sub_path(cr);
+	cairo_arc(cr, x + w - r, y + r, r, -G_PI_2, 0);
+	cairo_arc(cr, x + w - r, y + h - r, r, 0, G_PI_2);
+	cairo_arc(cr, x + r, y + h - r, r, G_PI_2, G_PI);
+	cairo_arc(cr, x + r, y + r, r, G_PI, 3 * G_PI_2);
+	cairo_close_path(cr);
+}
+
+static struct lab_data_buffer *
+shape_render(struct scaled_buffer *self, double scale)
+{
+	struct shape *shape = self->data;
+	struct lab_data_buffer *buffer = buffer_create_cairo(
+		shape->width, shape->height, scale);
+	if (!buffer) {
+		return NULL;
+	}
+	cairo_t *cr = cairo_create(buffer->surface);
+	double w = shape->width, h = shape->height, r = shape->radius;
+	if (shape->arrow) {
+		set_cairo_color(cr, shape->color);
+		cairo_set_line_width(cr, 1.0);
+		cairo_move_to(cr, w, 0);
+		cairo_line_to(cr, w * 0.5, h);
+		cairo_line_to(cr, 0, 0);
+		cairo_stroke_preserve(cr);
+		cairo_fill(cr);
+	} else {
+		set_cairo_color(cr, shape->color);
+		rounded_rect(cr, 0, 0, w, h, r);
+		cairo_fill(cr);
+		if (shape->border[3] > 0) {
+			set_cairo_color(cr, shape->border);
+			cairo_set_line_width(cr, 1.0);
+			rounded_rect(cr, 0.5, 0.5, w - 1.0, h - 1.0, MAX(0.0, r - 0.5));
+			cairo_stroke(cr);
+		}
+	}
+	cairo_destroy(cr);
+	cairo_surface_flush(buffer->surface);
+	return buffer;
+}
+
+static void
+shape_destroy(struct scaled_buffer *self)
+{
+	free(self->data);
+}
+
+static struct scaled_buffer *
+shape_create(struct wlr_scene_tree *parent, int width, int height,
+		int radius, const float *color, const float *border, bool arrow)
+{
+	static const struct scaled_buffer_impl impl = {
+		.create_buffer = shape_render,
+		.destroy = shape_destroy,
+	};
+	struct scaled_buffer *buffer = scaled_buffer_create(parent, &impl, true);
+	struct shape *shape = znew(*shape);
+	memcpy(shape->color, color, sizeof(shape->color));
+	if (border) {
+		memcpy(shape->border, border, sizeof(shape->border));
+	}
+	shape->width = width;
+	shape->height = height;
+	shape->radius = radius;
+	shape->arrow = arrow;
+	buffer->data = shape;
+	scaled_buffer_request_update(buffer, width, height);
+	return buffer;
+}
+
+static void
+label_create(struct wlr_scene_tree *tree, struct view *view,
+		int width, int pad, int y, bool window)
+{
+	struct buf text = BUF_INIT;
+	struct cycle_osd_field field = {
+		.content = window ? LAB_FIELD_TITLE : LAB_FIELD_DESKTOP_ENTRY_NAME,
+	};
+	cycle_osd_field_get_content(&field, &text, view);
+	struct scaled_font_buffer *label = scaled_font_buffer_create(tree);
+	scaled_font_buffer_update(label, text.data ? text.data : "",
+		width - 2 * pad, &rc.font_osd, foreground, transparent);
+	wlr_scene_node_set_position(&label->scene_buffer->node,
+		(width - label->width) / 2, y);
+	buf_reset(&text);
+}
+
+static struct application_item *
+item_create(struct cycle_osd_output *output, struct wlr_scene_tree *parent,
+		struct view *view, int width, int height)
+{
+	struct application_item *item = znew(*item);
+	item->base.view = view;
+	item->base.tree = lab_wlr_scene_tree_create(parent);
+	wl_list_append(&output->items, &item->base.link);
+	node_descriptor_create(&item->base.tree->node,
+		LAB_NODE_CYCLE_OSD_ITEM, NULL, item);
+	/* Transparent hitbox also makes empty tile space clickable. */
+	lab_wlr_scene_rect_create(item->base.tree, width, height, (float[4]){0});
+	item->selected = shape_create(item->base.tree,
+		width, height, ITEM_RADIUS, selected, NULL, false);
+	item->highlighted = shape_create(item->base.tree,
+		width, height, ITEM_RADIUS, highlighted, NULL, false);
+	wlr_scene_node_set_enabled(&item->highlighted->scene_buffer->node, false);
+	return item;
+}
+
+static int
+app_window_count(struct view *app)
+{
+	int count = 0;
+	struct view *view;
+	wl_list_for_each(view, &server.cycle.views, cycle_link) {
+		count += cycle_same_app(app, view);
+	}
+	return count;
+}
+
+static void
+windows_create(struct cycle_osd_output *osd_output, struct application_item *app,
+		int screen_width, int screen_height, int app_x, int tile_width,
+		int panel_width, int panel_height, int panel_y)
+{
+	int count = app_window_count(app->base.view);
+	int pad = ITEM_PADDING + THUMB_BOX_PADDING;
+	int label_h = font_height(&rc.font_osd);
+	/* Keep all windows on screen, shrinking thumbnails on small outputs. */
+	int max_item_w = (screen_width - 2 * SWITCHER_PADDING - (count - 1) * ITEM_SPACING) / count;
+	int thumb_w = MIN(THUMB_DEFAULT_SIZE, MAX(48, max_item_w - 2 * pad));
+	int width = thumb_w + 2 * pad;
+	int avail_h = screen_height - panel_y - panel_height - POPUP_SPACING - 2 * SWITCHER_PADDING;
+	int max_bin_h = MIN(THUMB_DEFAULT_SIZE, MAX(48, avail_h - 2 * pad - ITEM_PADDING - label_h));
+	int bin_h = 48;
+	struct view *view;
+	wl_list_for_each(view, &server.cycle.views, cycle_link) {
+		if (!cycle_same_app(app->base.view, view)) {
+			continue;
+		}
+		int vw = MAX(1, view->current.width);
+		int vh = MAX(1, view->current.height);
+		double scale = MIN(1.0, MIN((double)thumb_w / vw, (double)max_bin_h / vh));
+		bin_h = MAX(bin_h, (int)(vh * scale + 0.5));
+	}
+	int height = bin_h + 2 * pad + ITEM_PADDING + label_h;
+	int total_width = count * width + (count - 1) * ITEM_SPACING + 2 * SWITCHER_PADDING;
+	app->windows = lab_wlr_scene_tree_create(osd_output->tree);
+	shape_create(app->windows, total_width, height + 2 * SWITCHER_PADDING,
+		SWITCHER_RADIUS, background, panel_border, false);
+	int x = app_x + tile_width / 2 - total_width / 2;
+	/* Coordinates here are relative to the centered application panel. */
+	int panel_x = (screen_width - panel_width) / 2;
+	x = MAX(-panel_x, MIN(x, screen_width - panel_x - total_width));
+	wlr_scene_node_set_position(&app->windows->node, x, panel_height + POPUP_SPACING);
+	int index = 0;
+	wl_list_for_each(view, &server.cycle.views, cycle_link) {
+		if (!cycle_same_app(app->base.view, view)) {
+			continue;
+		}
+		struct application_item *item = item_create(osd_output,
+			app->windows, view, width, height);
+		wlr_scene_node_set_position(&item->base.tree->node,
+			SWITCHER_PADDING + index++ * (width + ITEM_SPACING), SWITCHER_PADDING);
+		struct wlr_box bounds = {
+			.x = pad, .y = pad,
+			.width = thumb_w, .height = bin_h,
+		};
+		struct wlr_buffer *buffer = cycle_render_thumbnail(osd_output->output, view);
+		if (buffer) {
+			struct wlr_box box = box_fit_within(buffer->width, buffer->height, &bounds);
+			struct wlr_scene_buffer *thumb =
+				lab_wlr_scene_buffer_create(item->base.tree, buffer);
+			wlr_scene_buffer_set_dest_size(thumb, box.width, box.height);
+			wlr_scene_node_set_position(&thumb->node, box.x, box.y);
+			wlr_buffer_drop(buffer);
+		}
+		label_create(item->base.tree, view, width, pad,
+			pad + bin_h + ITEM_PADDING, true);
+	}
+	wlr_scene_node_set_enabled(&app->windows->node, false);
+}
+
+static void
+applications_init(struct cycle_osd_output *osd_output)
+{
+	int screen_width, screen_height;
+	wlr_output_effective_resolution(osd_output->output->wlr_output,
+		&screen_width, &screen_height);
+	int count = 0;
+	struct view *view;
+	wl_list_for_each(view, &server.cycle.views, cycle_link) {
+		count += cycle_app_representative(view) == view;
+	}
+	assert(count > 0);
+	int label_h = font_height(&rc.font_osd);
+	int icon_spacing = label_h + 2 * ITEM_PADDING;
+	int sizes[] = {96, 64, 48, 32, 22};
+	int icon = 22;
+	for (size_t i = 0; i < sizeof(sizes) / sizeof(sizes[0]); i++) {
+		int sq = sizes[i] + icon_spacing;
+		if (count * sq + (count - 1) * ITEM_SPACING + 2 * SWITCHER_PADDING <= screen_width) {
+			icon = sizes[i];
+			break;
+		}
+	}
+	/* GNOME SwitcherButton(square=true) sets tile width equal to tile height. */
+	int tile_size = icon + icon_spacing;
+	int step = tile_size + ITEM_SPACING;
+	int slots = MIN(count, MAX(1, (screen_width - 2 * SWITCHER_PADDING + ITEM_SPACING) / step));
+	int width = slots * step - ITEM_SPACING + 2 * SWITCHER_PADDING;
+	int height = tile_size + 2 * SWITCHER_PADDING;
+	osd_output->tree = lab_wlr_scene_tree_create(osd_output->output->cycle_osd_tree);
+	shape_create(osd_output->tree, width, height,
+		SWITCHER_RADIUS, background, panel_border, false);
+	osd_output->items_tree = lab_wlr_scene_tree_create(osd_output->tree);
+	int index = 0;
+	wl_list_for_each(view, &server.cycle.views, cycle_link) {
+		if (cycle_app_representative(view) != view) {
+			continue;
+		}
+		struct application_item *item = item_create(osd_output,
+			osd_output->items_tree, view, tile_size, tile_size);
+		item->index = index++;
+		item->slots = slots;
+		item->step = step;
+		item->app_count = count;
+		int x = SWITCHER_PADDING + item->index * step;
+		wlr_scene_node_set_position(&item->base.tree->node, x, SWITCHER_PADDING);
+		struct scaled_icon_buffer *image = scaled_icon_buffer_create(
+			item->base.tree, icon, icon);
+		scaled_icon_buffer_set_view(image, view);
+		wlr_scene_node_set_position(&image->scene_buffer->node,
+			(tile_size - icon) / 2, ITEM_PADDING);
+		label_create(item->base.tree, view, tile_size, ITEM_PADDING,
+			ITEM_PADDING + icon + ITEM_PADDING, false);
+		item->arrow_dim = shape_create(item->base.tree,
+			ARROW_WIDTH, ARROW_HEIGHT, 0, arrow_dim, NULL, true);
+		item->arrow_bright = shape_create(item->base.tree,
+			ARROW_WIDTH, ARROW_HEIGHT, 0, foreground, NULL, true);
+		wlr_scene_node_set_position(&item->arrow_dim->scene_buffer->node,
+			(tile_size - ARROW_WIDTH) / 2, tile_size + ARROW_HEIGHT);
+		wlr_scene_node_set_position(&item->arrow_bright->scene_buffer->node,
+			(tile_size - ARROW_WIDTH) / 2, tile_size + ARROW_HEIGHT);
+		windows_create(osd_output, item, screen_width, screen_height,
+			x, tile_size, width, height, (screen_height - height) / 2);
+	}
+	struct wlr_box box;
+	wlr_output_layout_get_box(server.output_layout,
+		osd_output->output->wlr_output, &box);
+	wlr_scene_node_set_position(&osd_output->tree->node,
+		box.x + (screen_width - width) / 2, box.y + (screen_height - height) / 2);
+}
+
+static void
+applications_update(struct cycle_osd_output *osd_output)
+{
+	struct application_item *item;
+	int selected_index = 0;
+	wl_list_for_each(item, &osd_output->items, base.link) {
+		if (item->windows && cycle_same_app(item->base.view, server.cycle.selected_view)) {
+			selected_index = item->index;
+			break;
+		}
+	}
+	wl_list_for_each(item, &osd_output->items, base.link) {
+		if (item->windows) {
+			bool active = cycle_same_app(item->base.view, server.cycle.selected_view);
+			bool outline = active && server.cycle.window_selection;
+			int first = MAX(0, MIN(selected_index - item->slots / 2,
+				item->app_count - item->slots));
+			wlr_scene_node_set_enabled(&item->base.tree->node,
+				item->index >= first && item->index < first + item->slots);
+			wlr_scene_node_set_position(&item->base.tree->node,
+				SWITCHER_PADDING + (item->index - first) * item->step, SWITCHER_PADDING);
+			int nwindows = app_window_count(item->base.view);
+			wlr_scene_node_set_enabled(&item->windows->node, active
+				&& server.cycle.show_windows
+				&& (nwindows > 1 || server.cycle.window_selection));
+			wlr_scene_node_set_enabled(&item->selected->scene_buffer->node,
+				active && !outline);
+			wlr_scene_node_set_enabled(&item->highlighted->scene_buffer->node,
+				outline);
+			bool show_bright = active && (nwindows > 1 || outline);
+			bool show_dim = !active && nwindows > 1;
+			wlr_scene_node_set_enabled(&item->arrow_bright->scene_buffer->node, show_bright);
+			wlr_scene_node_set_enabled(&item->arrow_dim->scene_buffer->node, show_dim);
+		} else {
+			bool active = server.cycle.window_selection
+				&& item->base.view == server.cycle.selected_view;
+			wlr_scene_node_set_enabled(&item->selected->scene_buffer->node, active);
+			wlr_scene_node_set_enabled(&item->highlighted->scene_buffer->node, false);
+		}
+	}
+}
+
+struct cycle_osd_impl cycle_osd_applications_impl = {
+	.init = applications_init,
+	.update = applications_update,
+};
