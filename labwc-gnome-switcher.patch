+bool
+cycle_handle_app_key(uint32_t sym, bool backwards)
+{
+	if (!applications_style()) {
+		return false;
+	}
+	switch (sym) {
+	case XKB_KEY_grave:
+	case XKB_KEY_asciitilde:
+		cycle_app_window(backwards);
+		return true;
+	case XKB_KEY_Down:
+		server.cycle.window_selection = true;
+		server.cycle.show_windows = true;
+		update_cycle();
+		return true;
+	case XKB_KEY_Up:
+		server.cycle.window_selection = false;
+		server.cycle.show_windows = false;
+		update_cycle();
+		return true;
+	case XKB_KEY_Left:
+	case XKB_KEY_Right:
+		if (server.cycle.window_selection) {
+			cycle_app_window(sym == XKB_KEY_Left);
+		} else {
+			cycle_step(sym == XKB_KEY_Left
+				? LAB_CYCLE_DIR_BACKWARD : LAB_CYCLE_DIR_FORWARD);
+		}
+		return true;
+	case XKB_KEY_Return:
+	case XKB_KEY_KP_Enter:
+		cycle_finish(true);
+		return true;
+	default:
+		return false;
+	}
+}
